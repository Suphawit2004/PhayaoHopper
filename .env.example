NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional AI search. Server-only; never prefix these with NEXT_PUBLIC_.
# Without both values the assistant uses catalogue search and says so in the UI.
GEMINI_API_KEY=
GEMINI_MODEL=

# Auth (Magic Link + Google OAuth) — หลังใส่ค่าข้างบน อย่าลืมที่ Supabase Dashboard:
# 1. SQL Editor → run supabase/schema.sql (หรือใช้ supabase CLI: supabase db push
#    เพื่อ apply ไฟล์ใน supabase/migrations/)
# 2. Authentication → Providers → Email → เปิด Magic Link / Email OTP
# 3. Google OAuth (ถ้าต้องการปุ่ม "เข้าสู่ระบบด้วย Google"):
#    - console.cloud.google.com → สร้าง OAuth client ID (type: Web application)
#    - Authorized redirect URI:
#      https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
#    - Supabase → Authentication → Providers → Google → เปิดแล้ววาง Client ID/Secret
# 4. Authentication → URL Configuration → เพิ่ม Redirect URLs:
#    http://localhost:3000/auth/callback และ https://your-domain.example/auth/callback
